{% extends 'base.html.twig' %}

{% block title %}Catalogue — BiblioTech{% endblock %}

{% block body %}
    <section class="catalogue-entete">
        <div>
            <h1 class="page-titre">Le catalogue</h1>
            <p class="page-sous-titre">{{ livres|length }} livre{{ livres|length > 1 ? 's' }}</p>
        </div>

        <form method="get" action="{{ path('app_catalogue') }}" class="filtres">
            <select name="genre">
                <option value="">Tous les genres</option>
                {% for genre in genres %}
                    <option value="{{ genre }}" {{ genre == filtres.genre ? 'selected' }}>{{ genre }}</option>
                {% endfor %}
            </select>

            <select name="auteur">
                <option value="">Tous les auteurs</option>
                {% for auteur in auteurs %}
                    <option value="{{ auteur }}" {{ auteur == filtres.auteur ? 'selected' }}>{{ auteur }}</option>
                {% endfor %}
            </select>

            <select name="tri">
                <option value="">Trier par titre</option>
                <option value="annee_desc" {{ filtres.tri == 'annee_desc' ? 'selected' }}>Plus récents d'abord</option>
                <option value="annee_asc" {{ filtres.tri == 'annee_asc' ? 'selected' }}>Plus anciens d'abord</option>
            </select>

            <button type="submit" class="bouton">Filtrer</button>
            <a href="{{ path('app_catalogue') }}" class="lien-reset">Réinitialiser</a>
        </form>
    </section>

    <section class="grille">
        {% for livre in livres %}
            {% include '_carte.html.twig' %}
        {% endfor %}
    </section>
{% endblock %}