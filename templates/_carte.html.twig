<article class="carte">
    {# Partie 9 : remplacer # par {{ path('app_livre', {id: livre.id}) }} (2 fois) #}
    <a href="{{ path('app_livre', {id: livre.id}) }}" class="carte-couverture">
        <img src="{{ livre.couverture }}" alt="{{ livre.titre }}">
        {% if livre.estDisponible() %}
            <span class="badge badge-disponible">{{ livre.exemplairesDisponibles }} / {{ livre.exemplaires }} disponible{{ livre.exemplairesDisponibles > 1 ? 's' }}</span>
        {% else %}
            <span class="badge badge-indisponible">Indisponible</span>
        {% endif %}
    </a>
    <div class="carte-contenu">
        <span class="genre">{{ livre.genre }}</span>
        <h2 class="carte-titre">{{ livre.titre }}</h2>
        <p class="carte-auteur">{{ livre.auteur }}</p>
        <div class="carte-bas">
            <span class="carte-annee">{{ livre.annee }}</span>
            <a href="{{ path('app_livre', {id: livre.id}) }}" class="bouton bouton-petit">Voir</a>
        </div>
    </div>
</article>