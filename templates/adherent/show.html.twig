{% extends 'base.html.twig' %}

{% block title %}{{ adherent.nom }} — BiblioTech{% endblock %}

{% block body %}
    <nav class="fil-ariane">
        <a href="{{ path('app_catalogue') }}">Catalogue</a>
        <span>›</span>
        <span class="fil-actuel">{{ adherent.nom }}</span>
    </nav>

    <section class="catalogue-entete">
        <div>
            <h1 class="page-titre">{{ adherent.nom }}</h1>
            <p class="page-sous-titre">
                {{ adherent.ville ?? 'Ville non renseignée' }}
                · {{ adherent.email ?? 'Email non renseigné' }}
            </p>
        </div>
    </section>

    <section class="fiche-infos">
        <div class="info">
            <span class="info-label">Emprunts</span>
            <span class="info-valeur">{{ emprunts|length }}</span>
        </div>
        <div class="info">
            <span class="info-label">En cours</span>
            <span class="info-valeur">{{ emprunts|filter(e => e.estEnCours())|length }}</span>
        </div>
        <div class="info">
            <span class="info-label">Rendus</span>
            <span class="info-valeur">{{ emprunts|filter(e => not e.estEnCours())|length }}</span>
        </div>
    </section>

    <section class="section">
        <h2 class="section-titre">Historique des emprunts</h2>

        <table class="tableau">
            <thead>
                <tr>
                    <th>Livre</th>
                    <th>Auteur</th>
                    <th>Emprunté le</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for emprunt in emprunts %}
                    <tr>
                        <td><a href="{{ path('app_livre', {id: emprunt.livre.id}) }}">{{ emprunt.livre.titre }}</a></td>
                        <td>{{ emprunt.livre.auteur }}</td>
                        <td>{{ emprunt.dateEmprunt|date('d/m/Y') }}</td>
                        <td>
                            {% if emprunt.estEnCours() %}
                                <span class="statut statut-en-cours">En cours</span>
                            {% else %}
                                <span class="statut statut-rendu">Rendu le {{ emprunt.dateRetour|date('d/m/Y') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Cet adhérent n'a encore rien emprunté.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}